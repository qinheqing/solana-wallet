{
  "name": "solana-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Solana wallet testing toolkit — MCP server + Claude Skill + Web UI",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:examples",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "example": "tsx",
    "dev": "pnpm --filter @sol-wallet/web dev"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@sol-wallet/core": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.0.0"
  }
}
