{
  "name": "@sol-wallet/core",
  "version": "0.1.0",
  "description": "Core Solana wallet testing library — connections, wallets, transfers, tokens, multisig. Zero UI dependencies.",
  "keywords": [
    "solana",
    "wallet",
    "spl-token",
    "token-2022",
    "multisig",
    "squads",
    "testing"
  ],
  "license": "MIT",
  "author": "qinheqing",
  "homepage": "https://github.com/qinheqing/solana-wallet#readme",
  "bugs": {
    "url": "https://github.com/qinheqing/solana-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinheqing/solana-wallet.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --root ../.. packages/core",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.0",
    "@sqds/multisig": "^2.1.4",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
