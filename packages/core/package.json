{
  "name": "@solwallet/core",
  "version": "0.1.0",
  "description": "Core Solana wallet testing library — connections, wallets, transfers, tokens, multisig. Zero UI dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/web3.js": "^1.98.0",
    "@sqds/multisig": "^2.1.4",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
