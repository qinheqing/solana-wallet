{
  "name": "@sol-wallet/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing solana-wallet testing tools to AI clients",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "wallet",
    "spl-token",
    "token-2022",
    "claude"
  ],
  "license": "MIT",
  "author": "qinheqing",
  "homepage": "https://github.com/qinheqing/solana-wallet#readme",
  "bugs": {
    "url": "https://github.com/qinheqing/solana-wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinheqing/solana-wallet.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "solwallet-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-guide.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/mcp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "@sol-wallet/core": "workspace:^",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
